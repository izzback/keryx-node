<Window x:Class="Poolaris.NodeGui.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Poolaris Node GUI"
        Width="1500" Height="900"
        MinWidth="1180" MinHeight="720"
        WindowStartupLocation="CenterScreen">
    <Grid Background="{StaticResource Bg0Brush}">
        <Grid.RowDefinitions>
            <RowDefinition Height="72"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="48"/>
        </Grid.RowDefinitions>

        <Border Grid.Row="0" BorderBrush="{StaticResource PanelBorderBrush}" BorderThickness="0,0,0,1" Background="#06101B">
            <Grid Margin="18,0">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>
                <Image Grid.Column="0" Source="Assets/poolaris-logo.png" Width="150" Height="54" Stretch="Uniform"/>
                <Border Grid.Column="1" Width="1" Background="#29435B" Margin="18,18"/>
                <TextBlock Grid.Column="2" Text="Poolaris Node GUI" FontSize="25" FontWeight="SemiBold" VerticalAlignment="Center"/>
                <Border Grid.Column="3" x:Name="HeaderStatusBorder" Background="#0C2E1A" BorderBrush="#1F7D40" BorderThickness="1" CornerRadius="6" Padding="12,6" VerticalAlignment="Center">
                    <TextBlock x:Name="HeaderStatusText" Text="NODE STOPPED" Foreground="#FF6B6B" FontWeight="Bold"/>
                </Border>
            </Grid>
        </Border>

        <Grid Grid.Row="1">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="220"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>

            <Border Grid.Column="0" BorderBrush="{StaticResource PanelBorderBrush}" BorderThickness="0,0,1,0" Background="#06101B" Padding="12">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                        <RowDefinition Height="Auto"/>
                    </Grid.RowDefinitions>
                    <Button Grid.Row="0" Style="{StaticResource NavButton}" Content="⌂   Dashboard"/>
                    <Button Grid.Row="1" Style="{StaticResource NavButton}" Content="🚀  Node Launcher"/>
                    <Button Grid.Row="2" Style="{StaticResource NavButton}" Content="◎   Peers"/>
                    <Button Grid.Row="3" Style="{StaticResource NavButton}" Content="⌁   Performance"/>
                    <Button Grid.Row="4" Style="{StaticResource NavButton}" Content="▤   Logs"/>
                    <Border Grid.Row="6" Style="{StaticResource Panel}" Padding="10">
                        <StackPanel>
                            <TextBlock Text="Keryx Node" Foreground="{StaticResource CyanBrush}" FontWeight="SemiBold"/>
                            <TextBlock x:Name="SidebarVersion" Text="Version: detecting..." Foreground="{StaticResource MutedBrush}" Margin="0,8,0,0"/>
                            <TextBlock x:Name="SidebarPid" Text="PID: -" Foreground="{StaticResource MutedBrush}"/>
                            <TextBlock x:Name="SidebarUptime" Text="Uptime: -" Foreground="{StaticResource MutedBrush}"/>
                            <Image Source="Assets/poolaris-logo.png" Height="120" Stretch="Uniform" Margin="0,12,0,0"/>
                        </StackPanel>
                    </Border>
                </Grid>
            </Border>

            <ScrollViewer Grid.Column="1" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
                <Grid Margin="16">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="430"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>

                    <Border Grid.Column="0" Style="{StaticResource Panel}" Margin="0,0,14,0">
                        <StackPanel>
                            <TextBlock Text="🚀  Node Launcher" FontSize="18" FontWeight="SemiBold" Margin="0,0,0,14"/>

                            <TextBlock Text="Network" Foreground="{StaticResource MutedBrush}"/>
                            <StackPanel Orientation="Horizontal" Margin="0,6,0,12">
                                <RadioButton x:Name="MainnetRadio" Content="Mainnet" IsChecked="True" Margin="0,0,18,0"/>
                                <RadioButton x:Name="TestnetRadio" Content="Testnet"/>
                            </StackPanel>

                            <CheckBox x:Name="UtxoIndexCheck" Content="UTXO Index" IsChecked="True" Margin="0,5"/>
                            <CheckBox x:Name="InboundCheck" Content="Accept inbound connections" IsChecked="True" Margin="0,5"/>
                            <CheckBox x:Name="IbdPerfCheck" Content="IBD performance instrumentation" Margin="0,5,0,12"/>

                            <Grid Margin="0,2">
                                <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="90"/></Grid.ColumnDefinitions>
                                <CheckBox x:Name="GrpcCheck" Content="Enable gRPC" IsChecked="True" VerticalAlignment="Center"/>
                                <TextBox x:Name="GrpcPortBox" Grid.Column="1" Text="22110" Padding="6"/>
                            </Grid>
                            <Grid Margin="0,4">
                                <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="90"/></Grid.ColumnDefinitions>
                                <CheckBox x:Name="JsonCheck" Content="Enable wRPC JSON" IsChecked="True" VerticalAlignment="Center"/>
                                <TextBox x:Name="JsonPortBox" Grid.Column="1" Text="24110" Padding="6"/>
                            </Grid>
                            <Grid Margin="0,4,0,14">
                                <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="90"/></Grid.ColumnDefinitions>
                                <CheckBox x:Name="BorshCheck" Content="Enable wRPC Borsh" VerticalAlignment="Center"/>
                                <TextBox x:Name="BorshPortBox" Grid.Column="1" Text="23110" Padding="6"/>
                            </Grid>

                            <Grid>
                                <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="100"/></Grid.ColumnDefinitions>
                                <StackPanel Grid.Column="0" Margin="0,0,12,0">
                                    <TextBlock Text="Outbound peers" Foreground="{StaticResource MutedBrush}"/>
                                    <TextBox x:Name="OutboundBox" Text="24" Padding="6" Margin="0,4,0,8"/>
                                    <TextBlock Text="Async threads" Foreground="{StaticResource MutedBrush}"/>
                                    <TextBox x:Name="ThreadsBox" Text="32" Padding="6" Margin="0,4,0,8"/>
                                    <TextBlock Text="RocksDB cache (MiB)" Foreground="{StaticResource MutedBrush}"/>
                                    <TextBox x:Name="CacheBox" Text="8192" Padding="6" Margin="0,4,0,8"/>
                                </StackPanel>
                                <StackPanel Grid.Column="1">
                                    <TextBlock Text="Max inbound" Foreground="{StaticResource MutedBrush}"/>
                                    <TextBox x:Name="InboundBox" Text="128" Padding="6" Margin="0,4,0,8"/>
                                    <TextBlock Text="RAM scale" Foreground="{StaticResource MutedBrush}"/>
                                    <TextBox x:Name="RamScaleBox" Text="4.0" Padding="6" Margin="0,4,0,8"/>
                                    <TextBlock Text="Log level" Foreground="{StaticResource MutedBrush}"/>
                                    <ComboBox x:Name="LogLevelCombo" SelectedIndex="2" Margin="0,4,0,8">
                                        <ComboBoxItem Content="error"/><ComboBoxItem Content="warn"/><ComboBoxItem Content="info"/><ComboBoxItem Content="debug"/><ComboBoxItem Content="trace"/>
                                    </ComboBox>
                                </StackPanel>
                            </Grid>

                            <TextBlock Text="Data directory" Foreground="{StaticResource MutedBrush}" Margin="0,5,0,4"/>
                            <DockPanel>
                                <Button DockPanel.Dock="Right" Content="..." Width="34" Click="BrowseData_Click"/>
                                <TextBox x:Name="DataDirectoryBox" Text="E:\datanode\keryx-node" Padding="6" Margin="0,0,6,0"/>
                            </DockPanel>

                            <TextBlock Text="Node executable" Foreground="{StaticResource MutedBrush}" Margin="0,10,0,4"/>
                            <DockPanel>
                                <Button DockPanel.Dock="Right" Content="..." Width="34" Click="BrowseExecutable_Click"/>
                                <TextBox x:Name="ExecutableBox" Text="H:\keryx-node\keryxd.exe" Padding="6" Margin="0,0,6,0"/>
                            </DockPanel>

                            <TextBlock Text="Generated command" Foreground="{StaticResource MutedBrush}" Margin="0,10,0,4"/>
                            <TextBox x:Name="GeneratedCommandBox" IsReadOnly="True" TextWrapping="Wrap" Height="68" VerticalScrollBarVisibility="Auto" Background="#050B12" Foreground="#8FDFFF"/>

                            <Grid Margin="0,14,0,0">
                                <Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition/></Grid.ColumnDefinitions>
                                <Button Grid.Column="0" x:Name="StartButton" Style="{StaticResource PrimaryButton}" Content="▶  Start Node" Click="StartNode_Click" Margin="0,0,5,0"/>
                                <Button Grid.Column="1" x:Name="StopButton" Style="{StaticResource SecondaryButton}" Content="■  Stop Node" Click="StopNode_Click" Margin="5,0,0,0"/>
                            </Grid>
                            <Button x:Name="UpdateButton" Style="{StaticResource SecondaryButton}" Content="↻  Check for Node Updates" Click="CheckUpdates_Click" Margin="0,10,0,0"/>
                            <TextBlock x:Name="UpdateStatusText" Text="Updater ready" Foreground="{StaticResource MutedBrush}" HorizontalAlignment="Center" Margin="0,8,0,0"/>
                        </StackPanel>
                    </Border>

                    <Grid Grid.Column="1">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="*"/>
                        </Grid.RowDefinitions>

                        <Grid Grid.Row="0">
                            <Grid.ColumnDefinitions><ColumnDefinition Width="2*"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
                            <Border Grid.Column="0" Style="{StaticResource Panel}" Margin="0,0,7,0">
                                <StackPanel>
                                    <TextBlock Text="Sync Overview" FontSize="18" FontWeight="SemiBold"/>
                                    <Grid Margin="0,16,0,4">
                                        <Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                                        <TextBlock Text="Synchronization" Foreground="{StaticResource MutedBrush}"/>
                                        <TextBlock Grid.Column="1" x:Name="SyncPercentText" Text="Waiting for node data"/>
                                    </Grid>
                                    <ProgressBar x:Name="SyncProgressBar" Minimum="0" Maximum="100" Value="0" Height="18"/>
                                    <Grid Margin="0,18,0,0">
                                        <Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition/><ColumnDefinition/></Grid.ColumnDefinitions>
                                        <StackPanel Grid.Column="0"><TextBlock Text="Estimated blocks remaining" Foreground="{StaticResource MutedBrush}"/><TextBlock x:Name="BlocksRemainingText" Text="-" FontSize="23" Margin="0,5,0,0"/></StackPanel>
                                        <StackPanel Grid.Column="1"><TextBlock Text="Current blocks / s" Foreground="{StaticResource MutedBrush}"/><TextBlock x:Name="BlocksPerSecondText" Text="-" FontSize="23" Margin="0,5,0,0"/></StackPanel>
                                        <StackPanel Grid.Column="2"><TextBlock Text="Estimated ETA" Foreground="{StaticResource MutedBrush}"/><TextBlock x:Name="EtaText" Text="-" FontSize="23" Margin="0,5,0,0"/></StackPanel>
                                    </Grid>
                                </StackPanel>
                            </Border>

                            <Border Grid.Column="1" Style="{StaticResource Panel}" Margin="7,0,0,0">
                                <StackPanel>
                                    <TextBlock Text="Performance" FontSize="18" FontWeight="SemiBold"/>
                                    <TextBlock Text="CPU usage" Foreground="{StaticResource MutedBrush}" Margin="0,18,0,2"/>
                                    <TextBlock x:Name="CpuText" Text="-" FontSize="22"/>
                                    <TextBlock Text="RAM usage" Foreground="{StaticResource MutedBrush}" Margin="0,14,0,2"/>
                                    <TextBlock x:Name="RamText" Text="-" FontSize="22"/>
                                    <TextBlock Text="Threads" Foreground="{StaticResource MutedBrush}" Margin="0,14,0,2"/>
                                    <TextBlock x:Name="ThreadsText" Text="-" FontSize="22"/>
                                </StackPanel>
                            </Border>
                        </Grid>

                        <Grid Grid.Row="1" Margin="0,14,0,0">
                            <Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition/></Grid.ColumnDefinitions>
                            <Border Grid.Column="0" Style="{StaticResource Panel}" Margin="0,0,7,0">
                                <StackPanel>
                                    <TextBlock Text="Peers" FontSize="18" FontWeight="SemiBold"/>
                                    <TextBlock x:Name="PeersSummaryText" Text="Peer RPC monitor will attach when available." Foreground="{StaticResource MutedBrush}" Margin="0,12,0,0"/>
                                </StackPanel>
                            </Border>
                            <Border Grid.Column="1" Style="{StaticResource Panel}" Margin="7,0,0,0">
                                <StackPanel>
                                    <TextBlock Text="IBD Performance" FontSize="18" FontWeight="SemiBold"/>
                                    <TextBlock x:Name="IbdPerfText" Text="Waiting for IBD-PERF log samples..." Foreground="{StaticResource MutedBrush}" TextWrapping="Wrap" Margin="0,12,0,0"/>
                                </StackPanel>
                            </Border>
                        </Grid>

                        <Border Grid.Row="2" Style="{StaticResource Panel}" Margin="0,14,0,0">
                            <Grid>
                                <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/></Grid.RowDefinitions>
                                <TextBlock Text="Logs" FontSize="18" FontWeight="SemiBold"/>
                                <TextBox Grid.Row="1" x:Name="LogPreviewBox" Margin="0,12,0,0" Background="#03080E" Foreground="#CFE8F9" FontFamily="Cascadia Mono, Consolas" IsReadOnly="True" TextWrapping="NoWrap" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Auto"/>
                            </Grid>
                        </Border>
                    </Grid>
                </Grid>
            </ScrollViewer>
        </Grid>

        <Border Grid.Row="2" BorderBrush="{StaticResource PanelBorderBrush}" BorderThickness="0,1,0,0" Background="#06101B">
            <Grid Margin="18,0">
                <Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                <TextBlock x:Name="FooterText" Text="Node is stopped" Foreground="{StaticResource MutedBrush}" VerticalAlignment="Center"/>
                <TextBlock Grid.Column="1" Text="Poolaris • Keryx Node GUI" Foreground="{StaticResource MutedBrush}" VerticalAlignment="Center"/>
            </Grid>
        </Border>
    </Grid>
</Window>
