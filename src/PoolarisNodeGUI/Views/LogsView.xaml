<UserControl x:Class="PoolarisNodeGUI.Views.LogsView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="12" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <Border Style="{StaticResource CardStyle}">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>

                <StackPanel>
                    <TextBlock Text="KERYX LOGS" Style="{StaticResource SectionTitleStyle}" />
                    <TextBlock Text="Lecture seule du journal Keryx actif. Poolaris ne modifie et ne supprime jamais le fichier de log."
                               Foreground="{StaticResource MutedTextBrush}"
                               FontSize="11"
                               Margin="0,6,0,12"
                               TextWrapping="Wrap" />

                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="110" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>
                        <TextBlock Text="Log directory" Foreground="{StaticResource MutedTextBrush}" />
                        <TextBlock Grid.Column="1"
                                   Text="{Binding LogDirectory, Mode=OneWay}"
                                   TextTrimming="CharacterEllipsis"
                                   ToolTip="{Binding LogDirectory, Mode=OneWay}" />
                    </Grid>
                    <Grid Margin="0,5,0,0">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="110" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>
                        <TextBlock Text="Active file" Foreground="{StaticResource MutedTextBrush}" />
                        <TextBlock Grid.Column="1"
                                   Text="{Binding ActiveLogFile, Mode=OneWay}"
                                   Foreground="{StaticResource AccentBrush}"
                                   TextTrimming="CharacterEllipsis"
                                   ToolTip="{Binding ActiveLogFile, Mode=OneWay}" />
                    </Grid>
                    <Grid Margin="0,5,0,0">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="110" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>
                        <TextBlock Text="Status" Foreground="{StaticResource MutedTextBrush}" />
                        <TextBlock Grid.Column="1"
                                   Text="{Binding Status, Mode=OneWay}"
                                   TextWrapping="Wrap" />
                    </Grid>
                </StackPanel>

                <StackPanel Grid.Column="1" Margin="18,0,0,0" MinWidth="165">
                    <Button Content="Refresh now"
                            Style="{StaticResource SecondaryButtonStyle}"
                            Command="{Binding RefreshCommand}"
                            Margin="0,0,0,8" />
                    <Button Content="Clear view"
                            Style="{StaticResource SecondaryButtonStyle}"
                            Command="{Binding ClearViewCommand}"
                            ToolTip="Efface uniquement le texte affiché. Le fichier de log Keryx reste intact."
                            Margin="0,0,0,12" />
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <TextBlock Text="Auto refresh"
                                   VerticalAlignment="Center"
                                   Foreground="{StaticResource MutedTextBrush}" />
                        <ToggleButton Grid.Column="1"
                                      Style="{StaticResource SwitchStyle}"
                                      IsChecked="{Binding AutoRefresh}" />
                    </Grid>
                </StackPanel>
            </Grid>
        </Border>

        <Border Grid.Row="2" Style="{StaticResource CardStyle}" Padding="0">
            <Grid>
                <TextBox Text="{Binding LogText, Mode=OneWay}"
                         IsReadOnly="True"
                         AcceptsReturn="True"
                         AcceptsTab="True"
                         TextWrapping="NoWrap"
                         FontFamily="Consolas"
                         FontSize="12"
                         Background="#020B13"
                         BorderThickness="0"
                         Padding="12"
                         HorizontalScrollBarVisibility="Auto"
                         VerticalScrollBarVisibility="Auto"
                         VerticalContentAlignment="Top" />

                <TextBlock Text="Aucun log disponible pour le moment."
                           Foreground="{StaticResource MutedTextBrush}"
                           HorizontalAlignment="Center"
                           VerticalAlignment="Center"
                           FontSize="14"
                           IsHitTestVisible="False">
                    <TextBlock.Style>
                        <Style TargetType="TextBlock">
                            <Setter Property="Visibility" Value="Collapsed" />
                            <Style.Triggers>
                                <DataTrigger Binding="{Binding LogText}" Value="">
                                    <Setter Property="Visibility" Value="Visible" />
                                </DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </TextBlock.Style>
                </TextBlock>
            </Grid>
        </Border>
    </Grid>
</UserControl>
