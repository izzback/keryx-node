<UserControl x:Class="PoolarisNodeGUI.Views.DashboardView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <Grid>
        <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="*"/></Grid.RowDefinitions>
        <Grid.ColumnDefinitions><ColumnDefinition Width="1.1*"/><ColumnDefinition Width="1.4*"/><ColumnDefinition Width="1.1*"/></Grid.ColumnDefinitions>
        <Border Style="{StaticResource CardStyle}" Margin="0,0,10,10">
            <StackPanel><TextBlock Text="NODE" FontWeight="Bold"/><TextBlock Text="No node attached" Foreground="{StaticResource MutedTextBrush}" Margin="0,14,0,0"/><StackPanel Orientation="Horizontal" Margin="0,18,0,0"><Button Style="{StaticResource PrimaryButtonStyle}" Content="Start"/><Button Margin="8,0,0,0" Content="Stop" Padding="18,9"/></StackPanel></StackPanel>
        </Border>
        <Border Grid.Column="1" Style="{StaticResource CardStyle}" Margin="0,0,10,10">
            <StackPanel><TextBlock Text="SYNC OVERVIEW" FontWeight="Bold"/><TextBlock Text="Waiting for node" FontSize="24" FontWeight="SemiBold" Margin="0,18,0,0"/><TextBlock Text="Progress and ETA will appear only when a reliable source is available." TextWrapping="Wrap" Foreground="{StaticResource MutedTextBrush}" Margin="0,8,0,0"/></StackPanel>
        </Border>
        <Border Grid.Column="2" Style="{StaticResource CardStyle}" Margin="0,0,0,10">
            <StackPanel><TextBlock Text="PERFORMANCE" FontWeight="Bold"/><TextBlock Text="CPU          —" Margin="0,14,0,0"/><TextBlock Text="RAM          —" Margin="0,8,0,0"/><TextBlock Text="Disk I/O     —" Margin="0,8,0,0"/><TextBlock Text="Threads      —" Margin="0,8,0,0"/><TextBlock Text="Peers        —" Margin="0,8,0,0"/></StackPanel>
        </Border>
        <Border Grid.Row="1" Grid.ColumnSpan="2" Style="{StaticResource CardStyle}" Margin="0,0,10,10" Height="190">
            <StackPanel><TextBlock Text="NETWORK &amp; SYNC" FontWeight="Bold"/><UniformGrid Columns="4" Margin="0,18,0,0"><StackPanel><TextBlock Text="PEERS" Foreground="{StaticResource MutedTextBrush}"/><TextBlock Text="—" FontSize="24"/></StackPanel><StackPanel><TextBlock Text="IN / OUT" Foreground="{StaticResource MutedTextBrush}"/><TextBlock Text="— / —" FontSize="24"/></StackPanel><StackPanel><TextBlock Text="IBD SOURCE" Foreground="{StaticResource MutedTextBrush}"/><TextBlock Text="Not detected" FontSize="18" Foreground="{StaticResource WarningBrush}"/></StackPanel><StackPanel><TextBlock Text="BLOCKS / S" Foreground="{StaticResource MutedTextBrush}"/><TextBlock Text="—" FontSize="24"/></StackPanel></UniformGrid></StackPanel>
        </Border>
        <Border Grid.Row="1" Grid.Column="2" Style="{StaticResource CardStyle}" Margin="0,0,0,10" Height="190"><StackPanel><TextBlock Text="LOGS (LATEST)" FontWeight="Bold"/><TextBlock Text="Poolaris Node GUI is ready." Foreground="{StaticResource SuccessBrush}" Margin="0,16,0,0"/><TextBlock Text="Select or attach a Keryx node to begin." Foreground="{StaticResource MutedTextBrush}" Margin="0,8,0,0"/></StackPanel></Border>
    </Grid>
</UserControl>
