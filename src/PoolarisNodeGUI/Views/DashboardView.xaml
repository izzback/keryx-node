<UserControl x:Class="PoolarisNodeGUI.Views.DashboardView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="0.95*" />
            <RowDefinition Height="1.05*" />
        </Grid.RowDefinitions>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="0.92*" />
            <ColumnDefinition Width="1.45*" />
            <ColumnDefinition Width="1.08*" />
        </Grid.ColumnDefinitions>

        <Border Grid.RowSpan="2" Grid.Column="0" Style="{StaticResource CardStyle}" Margin="0,0,12,0">
            <Grid>
                <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
                <StackPanel>
                    <Grid>
                        <Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                        <TextBlock Text="◇  NODE CONTROL" Style="{StaticResource SectionTitleStyle}" />
                        <TextBlock Grid.Column="1" Text="{Binding NodeMode}" Foreground="{StaticResource AccentBrush}" FontSize="10" FontWeight="SemiBold" />
                    </Grid>
                    <TextBlock Text="Keryx process" Foreground="{StaticResource MutedTextBrush}" FontSize="11" Margin="0,18,0,5" />
                    <TextBlock Text="{Binding NodeLabel}" FontSize="18" FontWeight="SemiBold" />
                    <TextBlock Text="{Binding NodeExecutable}" TextWrapping="Wrap" Foreground="{StaticResource MutedTextBrush}" Margin="0,7,0,0" TextTrimming="CharacterEllipsis" />

                    <Border Height="1" Background="{StaticResource BorderBrush}" Margin="0,18,0,14" />

                    <Grid>
                        <Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                        <TextBlock Text="Version" Foreground="{StaticResource MutedTextBrush}" />
                        <TextBlock Grid.Column="1" Text="{Binding NodeVersion}" />
                    </Grid>
                    <Grid Margin="0,9,0,0">
                        <Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                        <TextBlock Text="PID" Foreground="{StaticResource MutedTextBrush}" />
                        <TextBlock Grid.Column="1" Text="{Binding NodePid}" />
                    </Grid>
                    <Grid Margin="0,9,0,0">
                        <Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                        <TextBlock Text="Uptime" Foreground="{StaticResource MutedTextBrush}" />
                        <TextBlock Grid.Column="1" Text="{Binding NodeUptime}" />
                    </Grid>
                    <Grid Margin="0,9,0,0">
                        <Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                        <TextBlock Text="RPC" Foreground="{StaticResource MutedTextBrush}" />
                        <TextBlock Grid.Column="1" Text="{Binding RpcStatus}" Foreground="{StaticResource AccentBrush}" />
                    </Grid>
                    <TextBlock Text="{Binding RpcEndpoint}" Foreground="{StaticResource MutedTextBrush}" FontSize="10" Margin="0,5,0,0" TextTrimming="CharacterEllipsis" />
                    <TextBlock Text="{Binding RpcError}" Foreground="{StaticResource DangerBrush}" FontSize="10" Margin="0,5,0,0" TextWrapping="Wrap" MaxHeight="48" />
                </StackPanel>

                <StackPanel Grid.Row="2">
                    <TextBlock Text="Fermer Poolaris ne doit jamais arrêter keryxd automatiquement." Foreground="{StaticResource MutedTextBrush}" TextWrapping="Wrap" FontSize="10" />
                    <TextBlock Text="Poolaris ne modifie jamais directement RocksDB." Foreground="{StaticResource MutedTextBrush}" TextWrapping="Wrap" FontSize="10" Margin="0,7,0,0" />
                </StackPanel>
            </Grid>
        </Border>

        <Border Grid.Column="1" Grid.Row="0" Style="{StaticResource CardStyle}" Margin="0,0,12,12">
            <StackPanel>
                <Grid>
                    <Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                    <TextBlock Text="◈  SYNC OVERVIEW" Style="{StaticResource SectionTitleStyle}" />
                    <TextBlock Grid.Column="1" Text="{Binding SyncState}" Foreground="{StaticResource AccentBrush}" FontWeight="SemiBold" />
                </Grid>

                <Grid Margin="0,14,0,0">
                    <Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                    <StackPanel>
                        <TextBlock Text="NETWORK" Foreground="{StaticResource MutedTextBrush}" FontSize="10" />
                        <TextBlock Text="{Binding NetworkName}" FontSize="16" FontWeight="SemiBold" Margin="0,4,0,0" />
                    </StackPanel>
                    <StackPanel Grid.Column="1" HorizontalAlignment="Right">
                        <TextBlock Text="RPC UPDATED" Foreground="{StaticResource MutedTextBrush}" FontSize="10" HorizontalAlignment="Right" />
                        <TextBlock Text="{Binding RpcLastUpdated}" FontSize="14" Margin="0,4,0,0" HorizontalAlignment="Right" />
                    </StackPanel>
                </Grid>

                <Border Height="1" Background="{StaticResource BorderBrush}" Margin="0,14,0,0" />

                <UniformGrid Columns="3" Margin="0,18,0,0">
                    <StackPanel>
                        <TextBlock Text="BLOCK COUNT" Foreground="{StaticResource MutedTextBrush}" FontSize="10" />
                        <TextBlock Text="{Binding BlockCount}" FontSize="22" FontWeight="SemiBold" Margin="0,5,0,0" />
                    </StackPanel>
                    <StackPanel>
                        <TextBlock Text="HEADER COUNT" Foreground="{StaticResource MutedTextBrush}" FontSize="10" />
                        <TextBlock Text="{Binding HeaderCount}" FontSize="22" FontWeight="SemiBold" Margin="0,5,0,0" />
                    </StackPanel>
                    <StackPanel>
                        <TextBlock Text="VIRTUAL DAA" Foreground="{StaticResource MutedTextBrush}" FontSize="10" />
                        <TextBlock Text="{Binding VirtualDaaScore}" FontSize="22" FontWeight="SemiBold" Margin="0,5,0,0" />
                    </StackPanel>
                </UniformGrid>

                <Border Height="1" Background="{StaticResource BorderBrush}" Margin="0,18,0,14" />
                <Grid>
                    <Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition/><ColumnDefinition/></Grid.ColumnDefinitions>
                    <StackPanel>
                        <TextBlock Text="MEMPOOL" Foreground="{StaticResource MutedTextBrush}" FontSize="10" />
                        <TextBlock Text="{Binding MempoolSize}" FontSize="16" Margin="0,5,0,0" />
                    </StackPanel>
                    <StackPanel Grid.Column="1">
                        <TextBlock Text="UTXO INDEX" Foreground="{StaticResource MutedTextBrush}" FontSize="10" />
                        <TextBlock Text="{Binding UtxoIndex}" FontSize="16" Margin="0,5,0,0" />
                    </StackPanel>
                    <StackPanel Grid.Column="2">
                        <TextBlock Text="DIFFICULTY" Foreground="{StaticResource MutedTextBrush}" FontSize="10" />
                        <TextBlock Text="{Binding Difficulty}" FontSize="16" Margin="0,5,0,0" />
                    </StackPanel>
                </Grid>
            </StackPanel>
        </Border>

        <Border Grid.Column="2" Grid.Row="0" Style="{StaticResource CardStyle}" Margin="0,0,0,12">
            <StackPanel>
                <TextBlock Text="⌁  PERFORMANCE" Style="{StaticResource SectionTitleStyle}" />
                <Grid Margin="0,18,0,0"><Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions><TextBlock Text="CPU Usage" ToolTip="Pourcentage de la capacité CPU totale de la machine utilisée par le processus keryxd attaché."/><TextBlock Grid.Column="1" Text="{Binding CpuUsage}" Foreground="{StaticResource AccentBrush}"/></Grid>
                <Border Height="1" Background="{StaticResource BorderBrush}" Margin="0,12"/>
                <Grid><Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions><TextBlock Text="Private Memory" ToolTip="Mémoire privée réservée au processus keryxd attaché."/><TextBlock Grid.Column="1" Text="{Binding PrivateMemory}" Foreground="{StaticResource AccentBrush}"/></Grid>
                <Border Height="1" Background="{StaticResource BorderBrush}" Margin="0,12"/>
                <Grid><Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions><TextBlock Text="Working Set" ToolTip="Mémoire actuellement résidente en RAM physique pour keryxd."/><TextBlock Grid.Column="1" Text="{Binding WorkingSet}" Foreground="{StaticResource AccentBrush}"/></Grid>
                <Border Height="1" Background="{StaticResource BorderBrush}" Margin="0,12"/>
                <Grid><Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions><TextBlock Text="Disk I/O" ToolTip="Débits disque calculés entre deux échantillons, et non compteurs cumulés."/><TextBlock Grid.Column="1" Text="{Binding DiskIo}" Foreground="{StaticResource AccentBrush}"/></Grid>
                <Border Height="1" Background="{StaticResource BorderBrush}" Margin="0,12"/>
                <Grid><Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions><TextBlock Text="Threads"/><TextBlock Grid.Column="1" Text="{Binding Threads}" Foreground="{StaticResource AccentBrush}"/></Grid>
                <Border Height="1" Background="{StaticResource BorderBrush}" Margin="0,12"/>
                <Grid><Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions><TextBlock Text="Handles"/><TextBlock Grid.Column="1" Text="{Binding Handles}" Foreground="{StaticResource AccentBrush}"/></Grid>
            </StackPanel>
        </Border>

        <Border Grid.Column="1" Grid.Row="1" Style="{StaticResource CardStyle}" Margin="0,0,12,0">
            <StackPanel>
                <Grid>
                    <Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                    <TextBlock Text="◎  PEERS" Style="{StaticResource SectionTitleStyle}" />
                    <TextBlock Grid.Column="1" Text="RPC LIVE" Foreground="{StaticResource AccentBrush}" FontSize="10" />
                </Grid>

                <UniformGrid Columns="3" Margin="0,18,0,0">
                    <StackPanel>
                        <TextBlock Text="CONNECTED" Foreground="{StaticResource MutedTextBrush}" FontSize="10" />
                        <TextBlock Text="{Binding PeerCount}" FontSize="24" FontWeight="SemiBold" Margin="0,5,0,0" />
                    </StackPanel>
                    <StackPanel>
                        <TextBlock Text="IN / OUT" Foreground="{StaticResource MutedTextBrush}" FontSize="10" />
                        <TextBlock Text="{Binding InboundOutbound}" FontSize="24" FontWeight="SemiBold" Margin="0,5,0,0" />
                    </StackPanel>
                    <StackPanel>
                        <TextBlock Text="IBD SOURCE" Foreground="{StaticResource MutedTextBrush}" FontSize="10" />
                        <TextBlock Text="{Binding IbdSource}" FontSize="14" FontWeight="SemiBold" Margin="0,7,0,0" TextTrimming="CharacterEllipsis" />
                    </StackPanel>
                </UniformGrid>

                <Border Height="1" Background="{StaticResource BorderBrush}" Margin="0,18,0,14" />
                <TextBlock Text="La page Peers affiche l’adresse, la direction, la valeur de ping RPC brute, le protocole et le booléen IBD Source." Foreground="{StaticResource MutedTextBrush}" TextWrapping="Wrap" FontSize="10" />
                <TextBlock Text="IBD Source est un booléen Keryx (YES/NO), jamais un pourcentage par peer." Foreground="{StaticResource MutedTextBrush}" FontSize="10" Margin="0,7,0,0" />
            </StackPanel>
        </Border>

        <Border Grid.Column="2" Grid.Row="1" Style="{StaticResource CardStyle}">
            <StackPanel>
                <Grid>
                    <Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                    <TextBlock Text="▤  RPC / LOG STATUS" Style="{StaticResource SectionTitleStyle}" />
                    <TextBlock Grid.Column="1" Text="{Binding RpcStatus}" Foreground="{StaticResource AccentBrush}" FontSize="10" />
                </Grid>
                <Border Background="#020A12" BorderBrush="{StaticResource BorderBrush}" BorderThickness="1" CornerRadius="5" Margin="0,14,0,0" Padding="10" MinHeight="160">
                    <StackPanel>
                        <TextBlock Text="INFO   Poolaris Node GUI is ready." Foreground="{StaticResource SuccessBrush}" FontFamily="Consolas" FontSize="11" />
                        <TextBlock Text="{Binding RpcEndpoint, StringFormat=RPC    {0}}" Foreground="{StaticResource MutedTextBrush}" FontFamily="Consolas" FontSize="11" Margin="0,6,0,0" />
                        <TextBlock Text="{Binding RpcLastUpdated, StringFormat=RPC    last update {0}}" Foreground="{StaticResource MutedTextBrush}" FontFamily="Consolas" FontSize="11" Margin="0,6,0,0" />
                        <TextBlock Text="INFO   Unavailable values remain displayed as —." Foreground="{StaticResource MutedTextBrush}" FontFamily="Consolas" FontSize="11" Margin="0,6,0,0" />
                        <TextBlock Text="{Binding RpcError}" Foreground="{StaticResource DangerBrush}" FontFamily="Consolas" FontSize="11" Margin="0,6,0,0" TextWrapping="Wrap" />
                    </StackPanel>
                </Border>
            </StackPanel>
        </Border>
    </Grid>
</UserControl>
