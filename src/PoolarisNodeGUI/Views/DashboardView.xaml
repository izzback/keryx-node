<UserControl x:Class="PoolarisNodeGUI.Views.DashboardView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="0.95*" />
            <RowDefinition Height="1.05*" />
        </Grid.RowDefinitions>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="0.92*" />
            <ColumnDefinition Width="1.45*" />
            <ColumnDefinition Width="1.08*" />
        </Grid.ColumnDefinitions>

        <Border Grid.RowSpan="2" Grid.Column="0" Style="{StaticResource CardStyle}" Margin="0,0,12,0">
            <Grid>
                <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
                <StackPanel>
                    <TextBlock Text="◇  NODE CONTROL" Style="{StaticResource SectionTitleStyle}" />
                    <TextBlock Text="Keryx process" Foreground="{StaticResource MutedTextBrush}" FontSize="11" Margin="0,18,0,5" />
                    <TextBlock Text="No node attached" FontSize="18" FontWeight="SemiBold" />
                    <TextBlock Text="Use Node Launcher to select keryxd.exe and the Keryx AppDir." TextWrapping="Wrap" Foreground="{StaticResource MutedTextBrush}" Margin="0,7,0,0" />

                    <Border Height="1" Background="{StaticResource BorderBrush}" Margin="0,18,0,14" />

                    <Grid>
                        <Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                        <TextBlock Text="Version" Foreground="{StaticResource MutedTextBrush}" />
                        <TextBlock Grid.Column="1" Text="—" />
                    </Grid>
                    <Grid Margin="0,9,0,0">
                        <Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                        <TextBlock Text="PID" Foreground="{StaticResource MutedTextBrush}" />
                        <TextBlock Grid.Column="1" Text="—" />
                    </Grid>
                    <Grid Margin="0,9,0,0">
                        <Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                        <TextBlock Text="Uptime" Foreground="{StaticResource MutedTextBrush}" />
                        <TextBlock Grid.Column="1" Text="—" />
                    </Grid>
                    <Grid Margin="0,9,0,0">
                        <Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                        <TextBlock Text="RPC" Foreground="{StaticResource MutedTextBrush}" />
                        <TextBlock Grid.Column="1" Text="Unavailable" Foreground="{StaticResource WarningBrush}" />
                    </Grid>
                </StackPanel>

                <StackPanel Grid.Row="2">
                    <Button Style="{StaticResource PrimaryButtonStyle}" Content="Open Node Launcher" IsEnabled="False" ToolTip="Navigation rapide ajoutée avec le runtime partagé dans la prochaine phase." />
                    <TextBlock Text="Poolaris ne modifiera jamais directement la base RocksDB." Foreground="{StaticResource MutedTextBrush}" TextWrapping="Wrap" FontSize="10" Margin="0,10,0,0" />
                </StackPanel>
            </Grid>
        </Border>

        <Border Grid.Column="1" Grid.Row="0" Style="{StaticResource CardStyle}" Margin="0,0,12,12">
            <StackPanel>
                <Grid>
                    <Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                    <TextBlock Text="◈  SYNC OVERVIEW" Style="{StaticResource SectionTitleStyle}" />
                    <TextBlock Grid.Column="1" Text="UNKNOWN" Foreground="{StaticResource MutedTextBrush}" FontWeight="SemiBold" />
                </Grid>
                <TextBlock Text="Sync Progress" Foreground="{StaticResource MutedTextBrush}" Margin="0,16,0,6" />
                <Border Height="20" Background="#03111D" BorderBrush="{StaticResource BorderBrush}" BorderThickness="1" CornerRadius="4">
                    <Grid><TextBlock Text="Waiting for a reliable sync source" FontSize="10" Foreground="{StaticResource MutedTextBrush}" HorizontalAlignment="Center" VerticalAlignment="Center" /></Grid>
                </Border>

                <UniformGrid Columns="3" Margin="0,18,0,0">
                    <StackPanel>
                        <TextBlock Text="ESTIMATED REMAINING" Foreground="{StaticResource MutedTextBrush}" FontSize="10" />
                        <TextBlock Text="—" FontSize="22" FontWeight="SemiBold" Margin="0,5,0,0" />
                    </StackPanel>
                    <StackPanel>
                        <TextBlock Text="CURRENT BLOCKS / S" Foreground="{StaticResource MutedTextBrush}" FontSize="10" />
                        <TextBlock Text="—" FontSize="22" FontWeight="SemiBold" Margin="0,5,0,0" />
                    </StackPanel>
                    <StackPanel>
                        <TextBlock Text="ESTIMATED ETA" Foreground="{StaticResource MutedTextBrush}" FontSize="10" />
                        <TextBlock Text="—" FontSize="22" FontWeight="SemiBold" Margin="0,5,0,0" />
                    </StackPanel>
                </UniformGrid>

                <Border Height="1" Background="{StaticResource BorderBrush}" Margin="0,18,0,14" />
                <Grid>
                    <Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition/></Grid.ColumnDefinitions>
                    <StackPanel>
                        <TextBlock Text="LOCAL BLOCK TIME" Foreground="{StaticResource MutedTextBrush}" FontSize="10" />
                        <TextBlock Text="—" FontSize="16" Margin="0,5,0,0" />
                    </StackPanel>
                    <StackPanel Grid.Column="1">
                        <TextBlock Text="NETWORK TARGET" Foreground="{StaticResource MutedTextBrush}" FontSize="10" />
                        <TextBlock Text="Unavailable" FontSize="16" Margin="0,5,0,0" />
                    </StackPanel>
                </Grid>
            </StackPanel>
        </Border>

        <Border Grid.Column="2" Grid.Row="0" Style="{StaticResource CardStyle}" Margin="0,0,0,12">
            <StackPanel>
                <TextBlock Text="⌁  PERFORMANCE" Style="{StaticResource SectionTitleStyle}" />
                <Grid Margin="0,18,0,0"><Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions><TextBlock Text="CPU Usage"/><TextBlock Grid.Column="1" Text="—" Foreground="{StaticResource AccentBrush}"/></Grid>
                <Border Height="1" Background="{StaticResource BorderBrush}" Margin="0,12"/>
                <Grid><Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions><TextBlock Text="Private Memory"/><TextBlock Grid.Column="1" Text="—" Foreground="{StaticResource AccentBrush}"/></Grid>
                <Border Height="1" Background="{StaticResource BorderBrush}" Margin="0,12"/>
                <Grid><Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions><TextBlock Text="Disk I/O"/><TextBlock Grid.Column="1" Text="—" Foreground="{StaticResource AccentBrush}"/></Grid>
                <Border Height="1" Background="{StaticResource BorderBrush}" Margin="0,12"/>
                <Grid><Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions><TextBlock Text="Threads"/><TextBlock Grid.Column="1" Text="—" Foreground="{StaticResource AccentBrush}"/></Grid>
                <Border Height="1" Background="{StaticResource BorderBrush}" Margin="0,12"/>
                <Grid><Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions><TextBlock Text="Peers"/><TextBlock Grid.Column="1" Text="—" Foreground="{StaticResource AccentBrush}"/></Grid>
            </StackPanel>
        </Border>

        <Border Grid.Column="1" Grid.Row="1" Style="{StaticResource CardStyle}" Margin="0,0,12,0">
            <StackPanel>
                <Grid>
                    <Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                    <TextBlock Text="◎  PEERS" Style="{StaticResource SectionTitleStyle}" />
                    <TextBlock Grid.Column="1" Text="View all" Foreground="{StaticResource AccentBrush}" />
                </Grid>
                <Grid Margin="0,16,0,8">
                    <Grid.ColumnDefinitions><ColumnDefinition Width="2*"/><ColumnDefinition/><ColumnDefinition/><ColumnDefinition/><ColumnDefinition/></Grid.ColumnDefinitions>
                    <TextBlock Text="Peer" Foreground="{StaticResource MutedTextBrush}"/>
                    <TextBlock Grid.Column="1" Text="Direction" Foreground="{StaticResource MutedTextBrush}"/>
                    <TextBlock Grid.Column="2" Text="Ping" Foreground="{StaticResource MutedTextBrush}"/>
                    <TextBlock Grid.Column="3" Text="IBD Source" Foreground="{StaticResource MutedTextBrush}"/>
                    <TextBlock Grid.Column="4" Text="Status" Foreground="{StaticResource MutedTextBrush}"/>
                </Grid>
                <Border Height="1" Background="{StaticResource BorderBrush}" />
                <TextBlock Text="No peer data available" Foreground="{StaticResource MutedTextBrush}" HorizontalAlignment="Center" Margin="0,34,0,0" />
                <TextBlock Text="IBD Source est un booléen Keryx (YES/NO), jamais un pourcentage par peer." Foreground="{StaticResource MutedTextBrush}" FontSize="10" HorizontalAlignment="Center" Margin="0,8,0,0" />
            </StackPanel>
        </Border>

        <Border Grid.Column="2" Grid.Row="1" Style="{StaticResource CardStyle}">
            <StackPanel>
                <Grid>
                    <Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                    <TextBlock Text="▤  LOGS (LATEST)" Style="{StaticResource SectionTitleStyle}" />
                    <TextBlock Grid.Column="1" Text="View full logs" Foreground="{StaticResource AccentBrush}" />
                </Grid>
                <Border Background="#020A12" BorderBrush="{StaticResource BorderBrush}" BorderThickness="1" CornerRadius="5" Margin="0,14,0,0" Padding="10" MinHeight="160">
                    <StackPanel>
                        <TextBlock Text="INFO   Poolaris Node GUI is ready." Foreground="{StaticResource SuccessBrush}" FontFamily="Consolas" FontSize="11" />
                        <TextBlock Text="INFO   Select or attach a Keryx node to begin." Foreground="{StaticResource MutedTextBrush}" FontFamily="Consolas" FontSize="11" Margin="0,6,0,0" />
                        <TextBlock Text="INFO   Unavailable values remain displayed as —." Foreground="{StaticResource MutedTextBrush}" FontFamily="Consolas" FontSize="11" Margin="0,6,0,0" />
                    </StackPanel>
                </Border>
            </StackPanel>
        </Border>
    </Grid>
</UserControl>
