<UserControl x:Class="PoolarisNodeGUI.Views.NodeLauncherView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <ScrollViewer VerticalScrollBarVisibility="Auto">
        <StackPanel MaxWidth="1100" HorizontalAlignment="Stretch">
            <Border Style="{StaticResource CardStyle}" Margin="0,0,0,12">
                <StackPanel>
                    <TextBlock Text="NODE" FontWeight="Bold"/>
                    <TextBlock Text="Keryx executable" Foreground="{StaticResource MutedTextBrush}" Margin="0,14,0,5"/>
                    <Grid><Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition Width="100"/></Grid.ColumnDefinitions><TextBox Height="32"/><Button Grid.Column="1" Margin="8,0,0,0" Content="Browse..."/></Grid>
                    <TextBlock Text="Keryx Application Directory (AppDir)" Foreground="{StaticResource MutedTextBrush}" Margin="0,12,0,5"/>
                    <Grid><Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition Width="100"/></Grid.ColumnDefinitions><TextBox Height="32"/><Button Grid.Column="1" Margin="8,0,0,0" Content="Browse..."/></Grid>
                    <TextBlock Text="Resolved database: —" Foreground="{StaticResource MutedTextBrush}" Margin="0,7,0,0"/>
                </StackPanel>
            </Border>
            <Border Style="{StaticResource CardStyle}" Margin="0,0,0,12"><StackPanel><TextBlock Text="NETWORK &amp; P2P" FontWeight="Bold"/><CheckBox Content="Mainnet" IsChecked="True" Margin="0,14,0,0"/><CheckBox Content="Accept inbound connections" Margin="0,8,0,0"/><CheckBox Content="DNS peer discovery" IsChecked="True" Margin="0,8,0,0"/><CheckBox Content="UPnP" IsChecked="True" Margin="0,8,0,0"/></StackPanel></Border>
            <Border Style="{StaticResource CardStyle}" Margin="0,0,0,12"><StackPanel><TextBlock Text="RPC — LOOPBACK BY DEFAULT" FontWeight="Bold"/><TextBlock Text="RPC listeners will default to 127.0.0.1." Foreground="{StaticResource MutedTextBrush}" Margin="0,8,0,10"/><CheckBox Content="Enable gRPC — 127.0.0.1:22110" IsChecked="True"/><CheckBox Content="Enable wRPC Borsh — 127.0.0.1:23110" Margin="0,8,0,0"/><CheckBox Content="Enable wRPC JSON — 127.0.0.1:24110" IsChecked="True" Margin="0,8,0,0"/></StackPanel></Border>
            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,6,0,18"><Button Style="{StaticResource PrimaryButtonStyle}" Content="Start Node"/><Button Content="Stop Node" Padding="18,9" Margin="8,0,0,0"/><Button Content="Restart" Padding="18,9" Margin="8,0,0,0"/></StackPanel>
        </StackPanel>
    </ScrollViewer>
</UserControl>
