<UserControl x:Class="PoolarisNodeGUI.Views.PeersView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="12" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <Border Style="{StaticResource CardStyle}">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="1.3*" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="1.6*" />
                </Grid.ColumnDefinitions>

                <StackPanel>
                    <TextBlock Text="◎  CONNECTED PEERS" Style="{StaticResource SectionTitleStyle}" />
                    <TextBlock Text="{Binding RpcStatus}" Foreground="{StaticResource AccentBrush}" FontWeight="SemiBold" Margin="0,9,0,0" />
                    <TextBlock Text="{Binding RpcEndpoint}" Foreground="{StaticResource MutedTextBrush}" FontSize="10" Margin="0,4,0,0" />
                </StackPanel>

                <StackPanel Grid.Column="1" Margin="18,0,0,0">
                    <TextBlock Text="TOTAL" Foreground="{StaticResource MutedTextBrush}" FontSize="10" />
                    <TextBlock Text="{Binding TotalPeers}" FontSize="24" FontWeight="SemiBold" Margin="0,5,0,0" />
                </StackPanel>
                <StackPanel Grid.Column="2" Margin="18,0,0,0">
                    <TextBlock Text="INBOUND" Foreground="{StaticResource MutedTextBrush}" FontSize="10" />
                    <TextBlock Text="{Binding InboundPeers}" FontSize="24" FontWeight="SemiBold" Margin="0,5,0,0" />
                </StackPanel>
                <StackPanel Grid.Column="3" Margin="18,0,0,0">
                    <TextBlock Text="OUTBOUND" Foreground="{StaticResource MutedTextBrush}" FontSize="10" />
                    <TextBlock Text="{Binding OutboundPeers}" FontSize="24" FontWeight="SemiBold" Margin="0,5,0,0" />
                </StackPanel>
                <StackPanel Grid.Column="4" Margin="18,0,0,0">
                    <TextBlock Text="IBD SOURCE" Foreground="{StaticResource MutedTextBrush}" FontSize="10" />
                    <TextBlock Text="{Binding IbdPeer}" FontSize="14" FontWeight="SemiBold" Margin="0,7,0,0" TextTrimming="CharacterEllipsis" />
                    <TextBlock Text="{Binding LastUpdated, StringFormat=Updated {0}}" Foreground="{StaticResource MutedTextBrush}" FontSize="10" Margin="0,4,0,0" />
                </StackPanel>
            </Grid>
        </Border>

        <Border Grid.Row="2" Style="{StaticResource CardStyle}" Padding="0">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="44" />
                    <RowDefinition Height="*" />
                    <RowDefinition Height="Auto" />
                </Grid.RowDefinitions>

                <Grid Margin="16,0">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="2.2*" />
                        <ColumnDefinition Width="0.9*" />
                        <ColumnDefinition Width="0.8*" />
                        <ColumnDefinition Width="0.8*" />
                        <ColumnDefinition Width="0.8*" />
                        <ColumnDefinition Width="2.2*" />
                    </Grid.ColumnDefinitions>
                    <TextBlock Text="Peer" Foreground="{StaticResource MutedTextBrush}" VerticalAlignment="Center" />
                    <TextBlock Grid.Column="1" Text="Direction" Foreground="{StaticResource MutedTextBrush}" VerticalAlignment="Center" />
                    <TextBlock Grid.Column="2" Text="Ping (raw)" Foreground="{StaticResource MutedTextBrush}" VerticalAlignment="Center" ToolTip="Valeur brute lastPingDuration renvoyée par le RPC Keryx. Aucune unité n’est ajoutée tant qu’elle n’est pas vérifiée dans le code P2P." />
                    <TextBlock Grid.Column="3" Text="IBD Source" Foreground="{StaticResource MutedTextBrush}" VerticalAlignment="Center" />
                    <TextBlock Grid.Column="4" Text="Protocol" Foreground="{StaticResource MutedTextBrush}" VerticalAlignment="Center" />
                    <TextBlock Grid.Column="5" Text="User agent" Foreground="{StaticResource MutedTextBrush}" VerticalAlignment="Center" />
                </Grid>

                <Border Grid.Row="1" BorderBrush="{StaticResource BorderBrush}" BorderThickness="0,1,0,1">
                    <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
                        <ItemsControl ItemsSource="{Binding Peers}">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <Border BorderBrush="{StaticResource BorderBrush}" BorderThickness="0,0,0,1" Padding="16,10">
                                        <Grid>
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="2.2*" />
                                                <ColumnDefinition Width="0.9*" />
                                                <ColumnDefinition Width="0.8*" />
                                                <ColumnDefinition Width="0.8*" />
                                                <ColumnDefinition Width="0.8*" />
                                                <ColumnDefinition Width="2.2*" />
                                            </Grid.ColumnDefinitions>
                                            <TextBlock Text="{Binding Address}" TextTrimming="CharacterEllipsis" />
                                            <TextBlock Grid.Column="1" Text="{Binding Direction}" />
                                            <TextBlock Grid.Column="2" Text="{Binding PingRaw}" />
                                            <TextBlock Grid.Column="3" Text="{Binding IbdSource}" Foreground="{StaticResource AccentBrush}" FontWeight="SemiBold" />
                                            <TextBlock Grid.Column="4" Text="{Binding Protocol}" />
                                            <TextBlock Grid.Column="5" Text="{Binding UserAgent}" Foreground="{StaticResource MutedTextBrush}" TextTrimming="CharacterEllipsis" />
                                        </Grid>
                                    </Border>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </ScrollViewer>
                </Border>

                <Grid Grid.Row="2" Margin="16,9">
                    <Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                    <TextBlock Text="IBD Source est le booléen isIbdPeer fourni par Keryx (YES/NO)." Foreground="{StaticResource MutedTextBrush}" FontSize="10" />
                    <TextBlock Grid.Column="1" Text="{Binding LastError}" Foreground="{StaticResource DangerBrush}" FontSize="10" TextTrimming="CharacterEllipsis" MaxWidth="520" />
                </Grid>
            </Grid>
        </Border>
    </Grid>
</UserControl>
