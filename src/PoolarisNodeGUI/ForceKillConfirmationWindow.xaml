<Window x:Class="PoolarisNodeGUI.ForceKillConfirmationWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Poolaris — Arrêt forcé"
        Width="520" Height="320"
        ResizeMode="NoResize"
        WindowStartupLocation="CenterOwner"
        ShowInTaskbar="False">
    <Border Background="{StaticResource SurfaceBrush}" BorderBrush="{StaticResource DangerBrush}" BorderThickness="1" CornerRadius="8" Padding="22">
        <Grid>
            <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
            <StackPanel>
                <TextBlock Text="⚠  Arrêt forcé du node Keryx" FontSize="19" FontWeight="SemiBold" Foreground="{StaticResource DangerBrush}" />
                <TextBlock Text="Cette opération termine immédiatement keryxd.exe et ne remplace pas un arrêt propre. Utilisez-la uniquement si le node ne répond plus." TextWrapping="Wrap" Foreground="{StaticResource MutedTextBrush}" Margin="0,14,0,0" />
            </StackPanel>
            <Border Grid.Row="1" Background="#030E17" BorderBrush="{StaticResource BorderBrush}" BorderThickness="1" CornerRadius="5" Padding="12" Margin="0,16,0,16">
                <StackPanel>
                    <TextBlock Text="Processus ciblé" Foreground="{StaticResource MutedTextBrush}" FontSize="11" />
                    <TextBlock x:Name="ProcessText" Text="keryxd.exe" FontFamily="Consolas" Margin="0,6,0,0" />
                    <TextBlock Text="Poolaris ne terminera aucun autre processus keryxd." Foreground="{StaticResource MutedTextBrush}" FontSize="10" Margin="0,8,0,0" />
                </StackPanel>
            </Border>
            <StackPanel Grid.Row="2" Orientation="Horizontal" HorizontalAlignment="Right">
                <Button Style="{StaticResource SecondaryButtonStyle}" Content="Annuler" MinWidth="110" Click="Cancel_Click" />
                <Button Style="{StaticResource DangerButtonStyle}" Content="Forcer l’arrêt" MinWidth="130" Margin="10,0,0,0" Click="Confirm_Click" />
            </StackPanel>
        </Grid>
    </Border>
</Window>
