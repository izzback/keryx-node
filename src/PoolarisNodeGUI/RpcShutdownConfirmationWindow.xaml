<Window x:Class="PoolarisNodeGUI.RpcShutdownConfirmationWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Poolaris — Arrêt RPC"
        Width="540" Height="350"
        ResizeMode="NoResize"
        WindowStartupLocation="CenterOwner"
        ShowInTaskbar="False">
    <Border Background="{StaticResource SurfaceBrush}" BorderBrush="{StaticResource WarningBrush}" BorderThickness="1" CornerRadius="8" Padding="22">
        <Grid>
            <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
            <StackPanel>
                <TextBlock Text="Arrêt propre du node Keryx" FontSize="19" FontWeight="SemiBold" Foreground="{StaticResource WarningBrush}" />
                <TextBlock Text="Poolaris va envoyer la commande Shutdown officielle via gRPC au node attaché. Aucun arrêt forcé ne sera tenté automatiquement si cette requête échoue." TextWrapping="Wrap" Foreground="{StaticResource MutedTextBrush}" Margin="0,14,0,0" />
            </StackPanel>
            <Border Grid.Row="1" Background="#030E17" BorderBrush="{StaticResource BorderBrush}" BorderThickness="1" CornerRadius="5" Padding="12" Margin="0,16,0,16">
                <StackPanel>
                    <TextBlock Text="Processus ciblé" Foreground="{StaticResource MutedTextBrush}" FontSize="11" />
                    <TextBlock x:Name="ProcessText" Text="keryxd.exe" FontFamily="Consolas" Margin="0,6,0,0" TextWrapping="Wrap" />
                    <TextBlock Text="Endpoint RPC vérifié" Foreground="{StaticResource MutedTextBrush}" FontSize="11" Margin="0,12,0,0" />
                    <TextBlock x:Name="EndpointText" Text="127.0.0.1:22110" FontFamily="Consolas" Margin="0,6,0,0" />
                    <TextBlock Text="Seuls les endpoints loopback locaux sont autorisés pour cette opération." Foreground="{StaticResource MutedTextBrush}" FontSize="10" Margin="0,8,0,0" />
                </StackPanel>
            </Border>
            <StackPanel Grid.Row="2" Orientation="Horizontal" HorizontalAlignment="Right">
                <Button Style="{StaticResource SecondaryButtonStyle}" Content="Annuler" MinWidth="110" Click="Cancel_Click" />
                <Button Style="{StaticResource PrimaryButtonStyle}" Content="Arrêter proprement" MinWidth="150" Margin="10,0,0,0" Click="Confirm_Click" />
            </StackPanel>
        </Grid>
    </Border>
</Window>
